{
  "name": "muchadoaboutoneside",
  "version": "0.1.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/presempathy-awb/muchadoaboutoneside.git"
  },
  "homepage": "https://muchadoaboutoneside.com",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:web": "bun --bun vite --host 127.0.0.1",
    "dev:api": "bun --watch server/index.ts",
    "build": "bun run typecheck && bun --bun vite build",
    "start": "NODE_ENV=production bun server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "verify:assets": "bun scripts/verify-assets.ts",
    "generate:inscription": "bun scripts/generate-inscription.ts",
    "generate:laser": "bun scripts/generate-laser.ts",
    "generate:small-foil": "bun scripts/generate-small-foil.ts",
    "generate:guide": "bun scripts/generate-calligraphy-guide.tsx",
    "generate:copperplate": "bun scripts/generate-copperplate.ts",
    "export:public": "bun scripts/export-public.ts",
    "check": "bun run lint && bun run typecheck && bun test && bun run verify:assets && bun scripts/generate-inscription.ts --check && bun scripts/generate-calligraphy-guide.tsx --check && bun scripts/generate-copperplate.ts --check && bun run verify:instructions && bun run verify:publication",
    "smoke": "bun scripts/smoke.ts",
    "verify:instructions": "bun scripts/verify-instructions.ts",
    "verify:publication": "bun scripts/verify-publication.ts",
    "generate:instructions": "bun scripts/generate-instructions.ts"
  },
  "dependencies": {
    "@babylonjs/core": "9.26.1",
    "@babylonjs/loaders": "9.26.1",
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@pdf-lib/fontkit": "1.1.1",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.36",
    "@xyflow/react": "12.11.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "elysia": "1.4.30",
    "lib0": "0.2.117",
    "lucide-react": "1.46.0",
    "pdf-lib": "1.17.1",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "y-codemirror.next": "0.3.6",
    "y-indexeddb": "9.0.12",
    "y-protocols": "1.0.7",
    "y-websocket": "3.1.0",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
